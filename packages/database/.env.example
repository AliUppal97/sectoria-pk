# Required for Prisma CLI (migrate/generate/studio/seed) run from this package.
# The app itself reads DATABASE_URL + ENCRYPTION_KEY from the root .env via
# packages/config/env.ts — these are duplicated here only as a placeholder
# reference for anyone running Prisma commands directly in this package.

# Postgres connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/sectoria_pk"

# AES-256-GCM key for CNIC/NTN field-level encryption: 32 random bytes,
# base64-encoded (e.g. `openssl rand -base64 32`). Rotate per ADR-005.
ENCRYPTION_KEY=""
