{
  "name": "@sectoria/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm --filter @sectoria/database db:generate && tsc --noEmit",
    "test": "pnpm --filter @sectoria/database db:generate && vitest run"
  },
  "dependencies": {
    "@sectoria/database": "workspace:*",
    "@sectoria/domain-allocation": "workspace:*",
    "@sectoria/domain-escrow": "workspace:*",
    "@sectoria/domain-ledger": "workspace:*",
    "@sectoria/domain-tax": "workspace:*",
    "@sectoria/domain-trust-score": "workspace:*",
    "@sectoria/types": "workspace:*",
    "@sectoria/verification": "workspace:*",
    "@trpc/server": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@sectoria/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
